    let array = function(arr){
         let sum =0;
         for(i=0;i<arr.length;i++){
            sum+= arr[i];
         }
         return sum;
    };
    document.write(array([10,20,30,40])+"<br>");

    let reverse = function(string){
        for(let  i=string.length;i>=0;i--){
            document.write(string[i]+"<br>")
        }

    }
