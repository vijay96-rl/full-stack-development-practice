<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>grid</title>
    <style>
      .contain{
        display: grid;
        grid-template-columns: repeat(3,1fr);
        grid-template-rows: 100px 100px 100px;
        gap: 10px;
        height: 100px;
        width: 150px;
      }
      .box{
        border: 3px solid rgb(14, 13, 13);
        text-align: center;
        
      }
    </style>
  </head>
  <body>
    <div class="contain">
      <div class="box">1 </div>
      <div class="box">2</div>

      <div class="box">3</div>

      <div class="box">4</div>

      <div class="box">5</div>

      <div class="box">6</div>

      <div class="box">7</div>

      <div class="box">8</div>
      <div class="box">9</div>


    </div>
  </body>
</html>
