<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<style>
  .vijay{
    background-color: rgb(50, 140, 134);
    padding: 34px;
    border: 2px  solid black;
    

  }
  .blue{
    background-color: blue;
    padding: 34px;
    border: 2px solid red;
  }
</style>
<body>
  <div class="container">
    <img id="image" src="https://upload.wikimedia.org/wikipedia/commons/b/b6/Image_created_with_a_mobile_phone.png"
     alt="this" 
     height="200" 
     width="200"
    >
  </div>
  <button id="btn"     onclick= "funct1()"> remove bule  </button>
  
</body>
</html>
<script>
  let img = document.getElementById("image")

  img.setAttribute("alt","an image of this photo")
 //  img.removeAttribute("this")
  console.log(img.getAttribute("alt"))
  img.classList.add("vijay")

  function funct1(){
   img.classList.remove("vijay")
   img.classList.toggle("blue")
   if(img.classList.contains("blue")){
    btn.innerText =" blue ?";

   }
   else{
    btn.innerText = "add blue"; 

   }


  }
  


</script>
